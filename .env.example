# Shared API and Worker runtime settings.
VESPERAFLOW_DATABASE_URL=postgresql+asyncpg://vespera:password@localhost:5432/vespera
VESPERAFLOW_TEMPORAL_ADDRESS=localhost:7233
VESPERAFLOW_TEMPORAL_NAMESPACE=default
VESPERAFLOW_TASK_QUEUE=vesperaflow-default
VESPERAFLOW_RUN_WORKSPACE_ROOT=/tmp/vesperaflow-runs

# Safe local default. Change the API default to claude_code when running live
# Claude tasks from the UI.
VESPERAFLOW_DEFAULT_EXECUTOR=debug_printer
VESPERAFLOW_EXECUTOR_ADAPTER=auto

# Claude Agent SDK guardrails.
VESPERAFLOW_CLAUDE_MAX_TURNS=20

# Claude Code subprocess defaults applied by the Worker:
# DISABLE_TELEMETRY=1
# DISABLE_ERROR_REPORTING=1
# DISABLE_FEEDBACK_COMMAND=1
# DISABLE_AUTOUPDATER=1
# CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
# ENABLE_LSP_TOOL=1
# CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS=1
# CLAUDE_CODE_NO_FLICKER=1

# Option A: export these in your shell or uncomment them locally in .env.
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_BASE_URL=https://your-proxy.example.com/v1
# ANTHROPIC_MODEL=claude-sonnet-4-5

# Option B: provide explicit SDK env values through VesperaFlow settings.
# Explicit values override passthrough values.
# VESPERAFLOW_CLAUDE_ENV={"ANTHROPIC_API_KEY":"sk-ant-...","ANTHROPIC_BASE_URL":"https://your-proxy.example.com/v1","ANTHROPIC_MODEL":"claude-sonnet-4-5"}
