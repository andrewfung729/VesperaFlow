{
  "version": "2.0.0",
  "inputs": [
    {
      "id": "alembicMessage",
      "type": "promptString",
      "description": "Migration message",
      "default": "auto"
    }
  ],
  "tasks": [
    {
      "label": "dev: all",
      "dependsOrder": "parallel",
      "dependsOn": ["dev: api", "dev: worker", "dev: web"],
      "problemMatcher": []
    },
    {
      "label": "dev: api",
      "type": "shell",
      "command": "uv run vesperaflow-api",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "group": "dev",
        "panel": "dedicated",
        "reveal": "always"
      }
    },
    {
      "label": "dev: worker",
      "type": "shell",
      "command": "uv run vesperaflow-worker",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "group": "dev",
        "panel": "dedicated",
        "reveal": "always"
      }
    },
    {
      "label": "dev: web",
      "type": "shell",
      "command": "bun run dev",
      "options": {
        "cwd": "${workspaceFolder}/apps/web"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "group": "dev",
        "panel": "dedicated",
        "reveal": "always"
      }
    },
    {
      "label": "db: migrate",
      "type": "shell",
      "command": "uv run --directory packages/store alembic upgrade head",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "group": "db",
        "panel": "dedicated",
        "reveal": "always"
      }
    },
    {
      "label": "db: revision",
      "type": "shell",
      "command": "uv run --directory packages/store alembic revision --autogenerate -m \"${input:alembicMessage}\"",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "group": "db",
        "panel": "dedicated",
        "reveal": "always"
      }
    },
    {
      "label": "db: downgrade",
      "type": "shell",
      "command": "uv run --directory packages/store alembic downgrade -1",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "group": "db",
        "panel": "dedicated",
        "reveal": "always"
      }
    }
  ]
}
